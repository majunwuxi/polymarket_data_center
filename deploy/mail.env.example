# Copy to /etc/polymarket-data/mail.env and fill in your mail provider's settings.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=report@example.com
SMTP_PASSWORD=replace-with-an-app-password
MAIL_FROM=report@example.com
MAIL_FROM_NAME="NBA 数据统计"
MAIL_TO=recipient@example.com
MAIL_CC=
MAIL_SUBJECT_PREFIX="NBA 次日比赛净买入统计"
